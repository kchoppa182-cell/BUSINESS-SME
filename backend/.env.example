# Supabase: use the project URL and server-only service_role key. Never expose this key in browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_public_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_server_only_service_role_key
# Optional only for a temporary single-business development workspace.
DEFAULT_BUSINESS_EMAIL=

# Never commit real credentials. Set these in your operating-system environment or deployment host.
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_test_secret

# Safaricom Daraja (use sandbox while testing; switch to production only after approval).
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=replace_with_daraja_consumer_key
MPESA_CONSUMER_SECRET=replace_with_daraja_consumer_secret
MPESA_SHORTCODE=short_code_number
MPESA_PASSKEY=replace_with_daraja_passkey
MPESA_CALLBACK_URL=https://your-public-domain.example/api/billing/mpesa/callback
MPESA_AMOUNT_KES=Amount


