{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "business-sme",
  "main": "./cloudflare-worker.mjs",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/"]
  }
}
